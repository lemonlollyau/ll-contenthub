# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables.
# Never commit .env.local.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Full database access: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-in allowlist (comma-separated) ---
ALLOWED_EMAILS=lemonlolly.au@gmail.com

# --- Encryption for stored API keys (32 random bytes, base64) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this later makes saved Buffer/Klaviyo keys unreadable.
ENCRYPTION_KEY=

# --- Google Drive service account (read-only) ---
# The whole JSON key file, base64-encoded:
#   base64 -i path/to/key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default set in src/lib/config.ts)
# CLAUDE_MODEL=claude-sonnet-5

# --- Content Studio Chrome extension ---
# A long random value; paste the same value into the extension's settings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXTENSION_SECRET=
